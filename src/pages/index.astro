---
/**
 * Root URL must return 200 + Open Graph for WhatsApp / social crawlers.
 * Humans are sent to /connexion; bots keep this HTML for the preview card.
 */
import SeoHead from '../components/SeoHead.astro';
import { LOCALE_BOOT_SCRIPT, localeFromRequest, t } from '../lib/i18n';

const locale = localeFromRequest(Astro.request);
const ua = Astro.request.headers.get('user-agent') ?? '';
const isSocialBot =
  /whatsapp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|SkypeUriPreview|iMessage|Applebot/i.test(
    ua,
  );

if (!isSocialBot) {
  return Astro.redirect('/connexion');
}

const title = t('brand.name', undefined, locale);
const description = t('auth.heroBody', undefined, locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f0f12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {t('brand.tagline', undefined, locale)}</title>
    <SeoHead title={title} description={description} locale={locale} />
    <script is:inline set:html={LOCALE_BOOT_SCRIPT} />
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>{description}</p>
      <p><a href="/connexion">{t('auth.signIn', undefined, locale)}</a></p>
    </main>
  </body>
</html>
