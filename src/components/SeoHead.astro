---
/**
 * Open Graph / Twitter Card tags for WhatsApp, iMessage, Slack, etc.
 * Image must be absolute HTTPS JPG/PNG (SVG is ignored by most crawlers).
 */
type Props = {
  title: string;
  description: string;
  /** Absolute or site-relative path; defaults to /og-image.jpg */
  image?: string;
  /** indexable landing vs app shell */
  noindex?: boolean;
  type?: 'website' | 'article';
  locale?: string;
};

const {
  title,
  description,
  image = '/og-image.jpg',
  noindex = false,
  type = 'website',
  locale = 'fr',
} = Astro.props;

const site = Astro.site ?? new URL('https://brick-gestion.vercel.app');
const canonical = new URL(Astro.url.pathname, site).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, site).toString();
const fullTitle = title.includes('Bricks') ? title : `${title} · Bricks`;
const ogLocale = locale === 'en' ? 'en_CM' : 'fr_CM';
---

<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Bricks" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="720" />
<meta property="og:image:alt" content={fullTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
